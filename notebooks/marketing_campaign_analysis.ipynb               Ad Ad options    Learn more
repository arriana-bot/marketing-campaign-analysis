    "\n",
    "# Identify potential outliers using the interquartile range\n",
    "for column in [\"budget\", \"spend\", \"clicks\", \"conversions\", \"revenue\", \"roas\"]:\n",
    "    q1 = df[column].quantile(0.25)\n",
    "    q3 = df[column].quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "\n",
    "    lower = q1 - 1.5 * iqr\n",
    "    upper = q3 + 1.5 * iqr\n",
    "\n",
    "    outliers = ((df[column] < lower) | (df[column] > upper)).sum()\n",
    "\n",
    "    print(f\"{column}: {outliers} potential outliers\")"
   ]
