    "# Convert dates to datetime\n",
    "df[\"start_date\"] = pd.to_datetime(df[\"start_date\"])\n",
    "df[\"end_date\"] = pd.to_datetime(df[\"end_date\"])\n",
    "\n",
    "# Check date order\n",
    "invalid_dates = (df[\"end_date\"] < df[\"start_date\"]).sum()\n",
    "\n",
    "# Check numerical relationships\n",
    "invalid_clicks = (df[\"clicks\"] > df[\"impressions\"]).sum()\n",
    "invalid_conversions = (df[\"conversions\"] > df[\"clicks\"]).sum()\n",
    "invalid_spend = (df[\"spend\"] <= 0).sum()\n",
    "\n",
    "print(\"End dates before start dates:\", invalid_dates)\n",
    "print(\"Clicks greater than impressions:\", invalid_clicks)\n",
